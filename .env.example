# ─── Database ───────────────────────────────────────────────────────────────
DB_HOST=ytcreator-ai-server.mysql.database.azure.com
DB_USER=openclaw
DB_PASSWORD=
DB_NAME=sowork_db

# SoWork DB (read-only for agents + market data; defaults to DB_* if not set separately)
SOWORK_DB_HOST=
SOWORK_DB_USER=
SOWORK_DB_PASSWORD=

# (Legacy) full connection string — kept for compatibility
DATABASE_URL=mysql://user:password@host:3306/sowork_enterprise

# ─── AI Providers ────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ZHIPU_API_KEY=
QIANWEN_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_AI_API_KEY=
COHERE_API_KEY=

# Azure AI Foundry / Claude Position resource (optional)
AZURE_POSITION_API_KEY=
AZURE_POSITION_ENDPOINT=
AZURE_POSITION_MODEL=claude-sonnet-4-6

# Forge (internal routing proxy)
FORGE_API_URL=
FORGE_API_KEY=

# ─── OpenClaw Integration ────────────────────────────────────────────────────
OPENCLAW_WORKSPACE_ID=

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Slack ───────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3001

# Set to 1 if behind a reverse proxy (Nginx / Azure Front Door / Cloudflare)
# Required for rate limiter to see the real client IP
TRUST_PROXY=1

# File path for billing retry log (persisted across restarts)
# Leave blank to use /tmp/billing-retry.jsonl (default, not persisted across container restarts)
BILLING_FALLBACK_LOG=/var/log/sowork/billing-retry.jsonl

# ─── Authentication ──────────────────────────────────────────────────────────
# Google OAuth (get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Canva Connect API（從 Canva 匯入設計）。redirect URL 要在 Canva Developer Portal 登記：<APP_URL>/api/oauth/canva/callback
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# 授權時要求的 scope（空白分隔）。留空＝只讀；integration 勾了 design:content:write、asset:write 才填。
CANVA_SCOPES=

# Email Service (Resend.com - get from https://resend.com/api-keys)
RESEND_API_KEY=

# JWT Secret (generate a strong random string, at least 32 chars)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# SoWork mos_db Agent / Skill 目錄的唯讀查詢。由管理員提供，切勿填入真值。
# 這個 key 只從環境變數讀取；MCP 不會去任何檔案或憑證庫尋找它。
MOS_MANUS_API_KEY=***

# Zernio（唯一的發布供應商，https://docs.zernio.com）
# 在 https://my.zernio.com 建 team 層級 API key（不要勾限定 profile）。
ZERNIO_API_KEY=

# 產圖存哪：local（VM 磁碟，預設）或 azure-blob
MEDIA_STORAGE=local
# MEDIA_STORAGE=azure-blob 時必填
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=onbrand-media
# 選填：接 CDN 或自訂網域時覆蓋公開網址前綴（不含結尾斜線）
MEDIA_PUBLIC_BASE_URL=
