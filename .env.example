# ─── Database ───────────────────────────────────────────────────────────────
DB_HOST=ytcreator-ai-server.mysql.database.azure.com
DB_USER=openclaw
DB_PASSWORD=
DB_NAME=sowork_db

# SoWork DB (read-only for agents + market data; defaults to DB_* if not set separately)
SOWORK_DB_HOST=
SOWORK_DB_USER=
SOWORK_DB_PASSWORD=

# (Legacy) full connection string — kept for compatibility
DATABASE_URL=mysql://user:password@host:3306/sowork_enterprise

# ─── AI Providers ────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ZHIPU_API_KEY=
QIANWEN_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_AI_API_KEY=
COHERE_API_KEY=

# Forge (internal routing proxy)
FORGE_API_URL=
FORGE_API_KEY=

# ─── Azure AI Search (RAG) ───────────────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=brand-knowledge

# ─── OpenClaw Integration ────────────────────────────────────────────────────
OPENCLAW_WORKSPACE_ID=

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Slack ───────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3001

# Set to 1 if behind a reverse proxy (Nginx / Azure Front Door / Cloudflare)
# Required for rate limiter to see the real client IP
TRUST_PROXY=1

# File path for billing retry log (persisted across restarts)
# Leave blank to use /tmp/billing-retry.jsonl (default, not persisted across container restarts)
BILLING_FALLBACK_LOG=/var/log/sowork/billing-retry.jsonl

# ─── Authentication ──────────────────────────────────────────────────────────
# Google OAuth (get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Service (Resend.com - get from https://resend.com/api-keys)
RESEND_API_KEY=

# JWT Secret (generate a strong random string, at least 32 chars)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
