# Marketing-OS — .env.example
#
# Copy to `.env` and fill in real values from your secrets vault (Doppler
# preferred). Never commit a populated .env. See
# docs/runbooks/secret-rotation.md for the full secret-management policy.

# ─── Primary DB (Azure MySQL — sowork_db) ────────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true

# ─── Local DB (mos_db on the app VM, read/write) ─────────────────────────────
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306
LOCAL_DB_USER=
LOCAL_DB_PASSWORD=
LOCAL_DB_NAME=mos_db

# ─── SoWork legacy DB (read-only agent/market data) ──────────────────────────
# Used by scripts/execute-phase-prea.ts and scripts/diagnose-db-migration.ts
SOWORK_DB_HOST=
SOWORK_DB_USER=
SOWORK_DB_PASSWORD=
SOWORK_DB_NAME=sowork_db

# (Legacy) full connection string — kept for backwards compatibility
DATABASE_URL=

# ─── AI Providers ────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
ZHIPU_API_KEY=
QWEN_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_AI_API_KEY=
GOOGLE_GEMINI_API_KEY=
GOOGLE_VERTEX_API_KEY=
COHERE_API_KEY=
TAVILY_API_KEY=

# Forge (internal routing proxy)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Azure Foundry (Claude on Azure)
AZURE_FOUNDRY_PROJECT_ENDPOINT=
AZURE_FOUNDRY_API_KEY=

# Azure OpenAI (embeddings + chat)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ─── Azure AI Search (RAG) ───────────────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=brand-knowledge

# ─── OpenClaw Gateway ────────────────────────────────────────────────────────
# The gateway process exposes /v1/chat/completions for PM + squad workers.
GATEWAY_HTTP=http://localhost:18790
GATEWAY_TOKEN=
OPENCLAW_WORKSPACE_ID=

# ─── AI Video Generation ─────────────────────────────────────────────────────
FAL_API_KEY=
ELEVENLABS_API_KEY=
CREATOMATE_API_KEY=

# ─── Transactional Email ─────────────────────────────────────────────────────
SENDGRID_API_KEY=
RESEND_API_KEY=

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Slack ───────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ─── OAuth (social login) ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ─── App secrets ─────────────────────────────────────────────────────────────
# JWT_SECRET: min 32 chars — `openssl rand -hex 32`
JWT_SECRET=
# SESSION_SECRET: min 32 chars — `openssl rand -hex 32`
SESSION_SECRET=

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3101
NODE_ENV=development
APP_URL=http://localhost:3101

# Set to 1 if behind a reverse proxy (Nginx / Azure Front Door / Cloudflare).
# Required for the rate limiter to see the real client IP.
TRUST_PROXY=1

# Persisted billing-retry log path (fall back to /tmp/billing-retry.jsonl if unset).
BILLING_FALLBACK_LOG=/var/log/sowork/billing-retry.jsonl

# Skills path override (defaults to ./skills relative to the app root).
SKILLS_PATH=
