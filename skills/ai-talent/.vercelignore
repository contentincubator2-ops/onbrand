node_modules
client/node_modules

# Force npm (via vercel.json installCommand). pnpm-lock.yaml is kept for
# local dev but is stale vs package.json (missing pdfkit) — if Vercel sees
# it, it auto-switches to pnpm and fails with ERR_PNPM_OUTDATED_LOCKFILE.
pnpm-lock.yaml

# Note: we must NOT ignore server/**/*.ts or api/**/*.ts here — esbuild
# needs them during buildCommand. After bundling, the buildCommand itself
# deletes api/*.ts so Vercel function discovery only picks up the bundled
# .js files.
.env
.env.*
!.env.example
dist
*.test.ts
**/*.test.ts
vitest.config.ts
ecosystem.config.cjs
ecosystem.dev.config.cjs
deploy-dev.sh
scripts/squad-builder
drizzle/migrations
docs
DEPLOY_TEST.md
AGENTS.md
SKILL.md
