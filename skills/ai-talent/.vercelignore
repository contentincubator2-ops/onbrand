node_modules
client/node_modules

# Force npm (via vercel.json installCommand). pnpm-lock.yaml is kept for
# local dev but is stale vs package.json (missing pdfkit) — if Vercel sees
# it, it auto-switches to pnpm and fails with ERR_PNPM_OUTDATED_LOCKFILE.
pnpm-lock.yaml

# Let Vercel only see bundled api/*.js (produced by scripts/bundle-vercel-fns.mjs
# during buildCommand). Shipping the .ts would make @vercel/node compile them
# individually and fail on extension-less relative imports at runtime.
api/**/*.ts
server/**/*.ts
!server/@types/**/*.ts
.env
.env.*
!.env.example
dist
*.test.ts
**/*.test.ts
vitest.config.ts
ecosystem.config.cjs
ecosystem.dev.config.cjs
deploy-dev.sh
scripts/squad-builder
drizzle/migrations
docs
DEPLOY_TEST.md
AGENTS.md
SKILL.md
