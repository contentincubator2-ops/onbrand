# Force npm (via vercel.json installCommand). pnpm-lock.yaml is kept for
# local dev but is stale vs package.json (missing pdfkit) — if Vercel sees
# it, it auto-switches to pnpm and fails with ERR_PNPM_OUTDATED_LOCKFILE.
pnpm-lock.yaml

# server/**/*.ts stays uploaded — esbuild needs them during buildCommand
# to bundle api/*.ts. The bundle script overwrites api/*.ts with
# self-contained bundled output before Vercel compiles functions.
.env
.env.*
!.env.example
dist
