    if (m3Id) { usedIds.push(m3Id); await assignSkillsToAgent(conn, m3Id, ["copywriting-pro", "hook-copywriter", "ad-copywriting-formulas"]); }
    const m3Info = await getAgentInfo(conn, m3Id);
