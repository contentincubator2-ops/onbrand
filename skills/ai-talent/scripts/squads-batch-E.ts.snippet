        assignAgentToStep({ order: 6, name: "內容商業化策略", description: "設計受眾商業化路徑：廣告、贊助、付費課程、書籍、活動，把受眾變成收入引擎", tool: "internal", outputType: "monetization_strategy", requiredSkills: ["marketing-strategy-pmm"] }, leadInfo),
