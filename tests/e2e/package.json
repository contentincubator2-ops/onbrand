{
  "name": "marketing-os-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright e2e + light stress tests for onbrand.sowork.ai",
  "scripts": {
    "test": "playwright test",
    "test:auth": "playwright test specs/auth.spec.ts",
    "test:brand": "playwright test specs/brand.spec.ts",
    "test:positioning": "playwright test specs/positioning.spec.ts",
    "test:article": "playwright test specs/article.spec.ts",
